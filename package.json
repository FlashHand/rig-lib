{
  "name": "rig-lib-workspace",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "yarn workspaces run build",
    "dev": "yarn workspaces run dev",
    "publish": "node scripts/publish.js",
    "publish:core": "node scripts/publish.js core",
    "publish:semaphore": "node scripts/publish.js semaphore",
    "publish:timer": "node scripts/publish.js timer",
    "publish:url": "node scripts/publish.js url",
    "publish:networking": "node scripts/publish.js networking",
    "publish:all": "node scripts/publish.js all"
  },
  "repository": "git@github.com:FlashHand/rig-lib.git",
  "author": "WangBo <ralwayne@163.com>",
  "license": "MIT",
  "devDependencies": {
    "commander": "^14.0.3",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0"
  },
  "keywords": [
    "semaphore",
    "concurrency",
    "concurrency-control",
    "mutex",
    "rate-limit",
    "throttle",
    "queue"
  ]
}
